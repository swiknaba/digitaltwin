#!/usr/bin/env python3
"""Stage checksum-pinned backend stdlib clients without credentials or app state."""
import hashlib
import json
from pathlib import Path
import shutil
import sys

root = Path(__file__).resolve().parent.parent
manifest = json.loads((root / "agent-runtime/contracts/kirei-clients.json").read_text())
target = root / ".local/kirei-clients"
try:
    files = manifest["files"]
    if set(files) != {"digitaltwin", "digitaltwin-mcp", "mcp.rb", "http_tools.rb", "agentsview_usage_response.rb", "agentsview_usage_authorizer.rb", "agentsview_usage_command.rb", "agentsview_usage_server.rb"}:
        raise ValueError("Unexpected client manifest")
    for name, entry in files.items():
        source = root / entry["source"]
        if not str(source.resolve()).startswith(str(root.resolve() / "integration-backend") + "/"):
            raise ValueError("Client source escapes backend")
        if hashlib.sha256(source.read_bytes()).hexdigest() != entry["sha256"]:
            raise ValueError("Backend client differs from the pinned Runtime contract")
    if target.exists() and any(path.name not in files for path in target.iterdir()):
        raise ValueError("Client context contains unexpected files")
    target.mkdir(parents=True, exist_ok=True)
    for name, entry in files.items():
        shutil.copyfile(root / entry["source"], target / name)
        (target / name).chmod(0o755)
    print("Prepared eight pinned stdlib clients; no credentials or sessions created")
except (OSError, ValueError) as error:
    print(f"Client context failed: {error}", file=sys.stderr)
    sys.exit(1)
