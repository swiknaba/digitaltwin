#!/usr/bin/env python3
"""Stage the single backend-owned callback file after component review/merge."""
import hashlib
from pathlib import Path
import shutil
import sys

root = Path(__file__).resolve().parent.parent
source = root / "integration-backend/bin/digitaltwin"
target = root / ".local/kirei-clients"
expected = "a062e47b3e196256e0ee5a75f63084645835072ac9bf6a9c0d73d41be0dcf7d1"
try:
    if hashlib.sha256(source.read_bytes()).hexdigest() != expected:
        raise ValueError("Backend client differs from the reviewed Runtime build contract")
    if target.exists() and any(path.name != "digitaltwin" for path in target.iterdir()):
        raise ValueError("Callback build context must contain only digitaltwin")
    target.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target / "digitaltwin")
    (target / "digitaltwin").chmod(0o755)
    print("Prepared single-file callback context; no credentials or sessions created")
except (OSError, ValueError) as error:
    print(f"Callback context failed: {error}", file=sys.stderr)
    sys.exit(1)
