#!/usr/bin/env python3
"""Local OpenCode-first checks. Uses public samples only; never reads .env."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import uuid

ROOT = Path(__file__).resolve().parent.parent
COMPOSE = ["docker", "compose", "--env-file", str(ROOT / ".env.example")]
ENV = {key: value for key, value in os.environ.items()
       if not key.startswith("COMPOSE_") and key not in {"POSTGRES_PASSWORD", "KIREI_DB_PASSWORD", "BACKEND_PORT"}}


def run(args, timeout=120, check=True):
    result = subprocess.run(args, cwd=ROOT, env=ENV, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if check and result.returncode:
        raise RuntimeError(f"command failed (exit {result.returncode}): {' '.join(args[:2])}")
    return result


def config():
    run(COMPOSE + ["-f", str(ROOT / "compose.yml"), "config", "--quiet"])
    print(json.dumps({"check": "compose-config", "passed": True, "mattermost": False, "application_build_or_boot": False}))


def dependencies():
    project = "digitaltwin-check-" + uuid.uuid4().hex[:12]
    with tempfile.TemporaryDirectory(prefix="digitaltwin-check-") as temporary:
        override = Path(temporary) / "compose.check.yml"
        override.write_text("services:\n  postgres:\n    ports: !override\n      - '127.0.0.1::5432'\n")
        args = COMPOSE + ["-p", project, "-f", str(ROOT / "compose.yml"), "-f", str(override)]
        cleanup_needed = False
        try:
            run(args + ["config", "--quiet"])
            cleanup_needed = True
            run(args + ["up", "-d", "--no-build", "--wait", "--wait-timeout", "120", "postgres"], timeout=180)
            base = args + ["exec", "-T", "-e", "PGPASSWORD=local-only-kirei", "postgres", "psql", "-h", "127.0.0.1", "-U", "kirei", "-At", "-d", "digitaltwin_development"]
            if run(base + ["-c", "SELECT current_user"]).stdout.strip() != "kirei":
                raise RuntimeError("Kirei database identity mismatch")
            print(json.dumps({"check": "disposable-postgres", "passed": True, "kirei_database": True,
                              "mattermost": False, "live_runtime": False, "disposable_resources_removed": True}))
        finally:
            if cleanup_needed:
                cleanup = run(args + ["down", "--volumes", "--remove-orphans"], check=False)
                if cleanup.returncode:
                    raise RuntimeError(f"cleanup failed; remove disposable project {project}")


def operator():
    print("""Open acceptance items (this command starts nothing):
1. Operator-owned Commander runtime identity, durable conversation recovery, and capability exchange.
2. Direct OpenCode remote-workspace, cancellation, restart, and mobile/pairing validation.
3. Kirei FutureTasks create, due delivery, reconciliation, and authorization acceptance.
No Mattermost, chat listener, push, or mobile application path remains in the default stack.
""")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=["config", "dependencies", "operator"])
    options = parser.parse_args()
    try:
        {"config": config, "dependencies": dependencies, "operator": operator}[options.mode]()
    except (RuntimeError, subprocess.TimeoutExpired, OSError) as error:
        print(f"acceptance failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
