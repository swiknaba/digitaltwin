#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$repo_root/scripts/local-env"
for _ in $(seq 1 120); do
  if curl --silent --show-error --fail "http://127.0.0.1:$PORT/readyz" >/dev/null; then
    cd "$repo_root/integration-backend"
    exec sh "$repo_root/scripts/local-ruby" "$repo_root/integration-backend/bin/worker"
  fi
  sleep 1
done
printf '%s\n' "Timed out waiting for Kirei web readiness" >&2
exit 1
