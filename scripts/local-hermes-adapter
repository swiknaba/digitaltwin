#!/bin/sh

set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$repo_root/scripts/local-env"

: "${DIGITALTWIN_HERMES_STATE_FILE:=$repo_root/local/hermes/commander-adapter-state.json}"
: "${DIGITALTWIN_HERMES_ADAPTER_PORT:=3087}"
export DIGITALTWIN_HERMES_STATE_FILE DIGITALTWIN_HERMES_ADAPTER_PORT

cd "$repo_root"
exec bun commander/hermes-adapter/server.ts
