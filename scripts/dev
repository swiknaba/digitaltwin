#!/bin/sh
set -eu

# Local boot only. Existing .env values and persistent data are preserved.
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"
umask 077
if [ ! -e .env ]; then
  cp .env.example .env
fi
scripts/prepare-callback-context

rebuild=
if [ "${1:-}" = "--build" ]; then
  rebuild=1
  shift
fi

if [ -n "$rebuild" ]; then
  docker compose -f compose.yml build
fi

docker compose -f compose.yml up -d --wait "$@"

if [ -n "$rebuild" ]; then
  docker image prune -f --filter dangling=true --filter label=com.docker.compose.project=digitaltwin
fi
