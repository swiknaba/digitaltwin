#!/bin/sh
set -eu

# Run against a deliberately started local stack. This command performs only
# authenticated chat/socket reads and does not start or prompt any provider.
project=${1:?usage: scripts/validate-local-commander COMPOSE_PROJECT_NAME}
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

docker compose -p "$project" -f compose.yml -f compose.local-commander.yml run --rm --no-deps -T backend-worker bin/validate-local-dispatch
docker compose -p "$project" -f compose.yml -f compose.local-commander.yml exec -T agent-runtime sh -ec 'command -v hermes >/dev/null && herdr status --json'
