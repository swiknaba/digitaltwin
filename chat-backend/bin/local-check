#!/usr/bin/env python3
"""Disposable startup/restart/empty-server restore. No accounts or tokens created."""
import argparse
import io
import json
from pathlib import Path
import subprocess
import tarfile
import time
from urllib.request import urlopen
from urllib.error import HTTPError, URLError
import uuid

ROOT = Path(__file__).resolve().parents[1]
POSTGRES = 'postgres:18.6-alpine'


def docker(*args, data=None):
    # Output is kept private. Docker errors may contain DSNs; never print them.
    result = subprocess.run(['docker', *args], input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        raise RuntimeError('Docker command failed: ' + args[0])
    return result.stdout


def wait_for(check, seconds=240):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        try:
            if check():
                return
        except (RuntimeError, HTTPError, URLError, OSError):
            pass
        time.sleep(2)
    raise RuntimeError('timed out waiting for disposable service')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--image', required=True, help='locally built derived image')
    args = parser.parse_args()
    name = 'dt-chat-' + uuid.uuid4().hex[:12]
    network = name + '-network'
    containers, volumes = [], []
    config = json.loads((ROOT / 'config/phase0.json').read_text())
    report = {'kind': 'live_disposable_unauthenticated', 'authenticated_chat': 'not_tested',
              'message_attachment_relationship_restore': 'not_tested', 'checks': []}

    def pg_start(suffix):
        pg = name + '-pg-' + suffix
        containers.append(pg)
        docker('run', '-d', '--name', pg, '--network', network,
               '-e', 'POSTGRES_PASSWORD=disposable-local-only', '-e', 'POSTGRES_USER=mattermost',
               '-e', 'POSTGRES_DB=mattermost', POSTGRES)
        wait_for(lambda: docker('exec', pg, 'pg_isready', '-U', 'mattermost', '-d', 'mattermost'))
        return pg

    def sql(pg, query):
        return docker('exec', pg, 'psql', '-U', 'mattermost', '-d', 'mattermost', '-At', '-v', 'ON_ERROR_STOP=1', '-c', query).decode().strip()

    def create_mm(pg, suffix):
        mm = name + '-mm-' + suffix
        containers.append(mm)
        mounts = []
        for kind in ('config', 'data', 'logs'):
            volume = mm + '-' + kind
            volumes.append(volume)
            docker('volume', 'create', volume)
            mounts.extend(['--mount', 'type=volume,source=' + volume + ',target=/mattermost/' + kind])
        docker('create', '--platform', 'linux/amd64', '--name', mm, '--network', network,
               '-p', '127.0.0.1::8065', '-e', 'MM_SQLSETTINGS_DATASOURCE=postgres://mattermost:disposable-local-only@' + pg + ':5432/mattermost?sslmode=disable&connect_timeout=10',
               '-e', 'MM_SERVICESETTINGS_SITEURL=http://localhost:8065', *mounts, args.image)
        return mm

    def health(mm):
        state = json.loads(docker('inspect', mm))[0]['State']
        if state.get('Health', {}).get('Status') != 'healthy':
            return False
        docker('exec', mm, '/mattermost/bin/mmctl', 'system', 'status', '--local')
        port = json.loads(docker('inspect', mm))[0]['NetworkSettings']['Ports']['8065/tcp'][0]['HostPort']
        base = 'http://127.0.0.1:' + port
        with urlopen(base + '/api/v4/system/ping', timeout=5) as response:
            if json.load(response).get('status') != 'OK' or not response.headers.get('X-Version-Id', '').startswith('11.11.1.'):
                raise RuntimeError('unexpected ping/version')
        for path in ('/api/v4/users/me', '/api/v4/channels/' + 'c' * 26 + '/posts'):
            try:
                urlopen(base + path, timeout=5)
                raise RuntimeError('unauthenticated protected endpoint accepted')
            except HTTPError as error:
                if error.code != 401:
                    raise RuntimeError('unexpected authentication status')
        return True

    def config_value(mm, key):
        return docker('exec', mm, '/mattermost/bin/mmctl', 'config', 'get', key, '--local').decode().strip()

    try:
        docker('network', 'create', network)
        pg = pg_start('source')
        mm = create_mm(pg, 'source')
        # Preserve image UID/GID from passwd, not host ownership.
        passwd = docker('cp', mm + ':/etc/passwd', '-')
        with tarfile.open(fileobj=io.BytesIO(passwd)) as archive:
            lines = archive.extractfile('passwd').read().decode().splitlines()
        uid, gid = next((int(x.split(':')[2]), int(x.split(':')[3])) for x in lines if x.startswith('mattermost:'))
        data = json.dumps(config).encode()
        archive_data = io.BytesIO()
        with tarfile.open(fileobj=archive_data, mode='w') as archive:
            info = tarfile.TarInfo('config.json')
            info.size, info.uid, info.gid, info.mode = len(data), uid, gid, 0o600
            archive.addfile(info, io.BytesIO(data))
        docker('cp', '-a', '-', mm + ':/mattermost/config', data=archive_data.getvalue())
        docker('start', mm)
        wait_for(lambda: health(mm))
        for key in ('Enable', 'EnableUploads', 'EnableMarketplace', 'EnableRemoteMarketplace', 'AutomaticPrepackagedPlugins'):
            if 'false' not in config_value(mm, 'PluginSettings.' + key).lower():
                raise RuntimeError('plugin configuration is enabled')
        report['checks'].extend(['native_mmctl_health', 'public_ping_version', 'protected_rest_401', 'all_plugin_settings_disabled'])
        # No users/messages/attachments: verify this scope explicitly before restore.
        counts = sql(pg, 'SELECT (SELECT count(*) FROM users), (SELECT count(*) FROM posts), (SELECT count(*) FROM fileinfo);')
        if counts != '0|0|0':
            raise RuntimeError('disposable server unexpectedly contains user data')
        docker('restart', mm)
        wait_for(lambda: health(mm))
        report['checks'].append('restart_persistent_volumes')
        docker('stop', mm)
        dump = docker('exec', pg, 'pg_dump', '-U', 'mattermost', '-d', 'mattermost', '-Fc')
        # Archive data and config together while application writes are stopped.
        snapshots = {kind: docker('cp', '-a', mm + ':/mattermost/' + kind + '/.', '-') for kind in ('config', 'data')}
        restored_pg = pg_start('restore')
        docker('exec', '-i', restored_pg, 'pg_restore', '-U', 'mattermost', '-d', 'mattermost', '--exit-on-error', data=dump)
        restored_mm = create_mm(restored_pg, 'restore')
        for kind, snapshot in snapshots.items():
            docker('cp', '-a', '-', restored_mm + ':/mattermost/' + kind, data=snapshot)
        docker('start', restored_mm)
        wait_for(lambda: health(restored_mm))
        if sql(restored_pg, 'SELECT (SELECT count(*) FROM users), (SELECT count(*) FROM posts), (SELECT count(*) FROM fileinfo);') != counts:
            raise RuntimeError('restored database counts differ')
        if 'false' not in config_value(restored_mm, 'PluginSettings.Enable').lower():
            raise RuntimeError('restored plugin configuration differs')
        report['checks'].append('quiesced_empty_database_config_data_restore_to_fresh_volumes')
        report['uid_gid'] = [uid, gid]
        report['empty_database_counts'] = {'users': 0, 'posts': 0, 'fileinfo': 0}
        report['image_id'] = json.loads(docker('image', 'inspect', args.image))[0]['Id']
    finally:
        for container in reversed(containers):
            subprocess.run(['docker', 'rm', '-f', '-v', container], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for volume in reversed(volumes):
            subprocess.run(['docker', 'volume', 'rm', volume], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(['docker', 'network', 'rm', network], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(json.dumps(report, indent=2))


if __name__ == '__main__':
    main()
