{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infrastructure-owned push secret references; proxy does not resolve these",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "secrets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "secrets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reference",
          "mount_path",
          "config_field"
        ],
        "properties": {
          "name": {
            "enum": [
              "apns-auth-key",
              "fcm-service-account"
            ]
          },
          "reference": {
            "type": "string",
            "pattern": "^op://[^/]+/[^/]+/[^/]+$"
          },
          "mount_path": {
            "enum": [
              "/run/secrets/apns-auth-key.p8",
              "/run/secrets/fcm-service-account.json"
            ]
          },
          "config_field": {
            "enum": [
              "ApplePushSettings[0].AppleAuthKeyFile",
              "AndroidPushSettings[0].ServiceFileLocation"
            ]
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "apns-auth-key"
              },
              "mount_path": {
                "const": "/run/secrets/apns-auth-key.p8"
              },
              "config_field": {
                "const": "ApplePushSettings[0].AppleAuthKeyFile"
              }
            },
            "required": [
              "name",
              "mount_path",
              "config_field"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "fcm-service-account"
              },
              "mount_path": {
                "const": "/run/secrets/fcm-service-account.json"
              },
              "config_field": {
                "const": "AndroidPushSettings[0].ServiceFileLocation"
              }
            },
            "required": [
              "name",
              "mount_path",
              "config_field"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  }
}
