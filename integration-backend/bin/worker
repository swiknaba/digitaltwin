#!/usr/bin/env ruby
# typed: strict
# frozen_string_literal: true

require_relative "../app"
Startup.validate!
exit if ENV["BOOT_CHECK_ONLY"] == "1"
require "async"
Async do
  composition = Services::Composition.instance
  Platform::Jobs::Worker.new(handlers: Services::JobHandlers.new(composition:).call).run(heartbeat_dir: composition.configuration.heartbeat_dir)
ensure
  Kirei::App.raw_db_connection.disconnect
end.wait
