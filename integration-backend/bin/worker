#!/usr/bin/env ruby
# typed: strict
# frozen_string_literal: true

require_relative "../app"
Startup.validate!
exit if ENV["BOOT_CHECK_ONLY"] == "1"
require "async"
Async do
  composition = Services::Composition.instance
  # This cutover worker intentionally owns no legacy chat or agent lifecycle jobs.
  # FutureTasks handlers are introduced as one bounded context in the next slice.
  Platform::Jobs::Worker.new(handlers: {}).run(heartbeat_dir: composition.configuration.heartbeat_dir)
ensure
  Kirei::App.raw_db_connection.disconnect
end.wait
