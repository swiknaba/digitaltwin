#!/usr/bin/env ruby
# typed: strict
# frozen_string_literal: true

# Standalone stdio bridge: no database or provider credentials in Runtime.
# In the repository the sources live in app/adapters/mcp; the Runtime image
# installs them next to this file as mcp.rb and http_tools.rb.
require "json"
require "net/http"
require "stringio"
require "uri"
require "sorbet-runtime"

repository_root = File.expand_path("../app/adapters/mcp", __dir__)
server_file, tools_file = if File.directory?(repository_root)
                            [File.join(repository_root, "server.rb"), File.join(repository_root, "http_tools.rb")]
                          else
                            [File.join(__dir__, "mcp.rb"), File.join(__dir__, "http_tools.rb")]
                          end
require server_file
require tools_file
tools = Adapters::Mcp::HttpTools.new(url: ENV.fetch("DIGITALTWIN_CALLBACK_URL"))
Adapters::Mcp::Server.new(tools: tools, token_file: ENV.fetch("DIGITALTWIN_MASTER_REQUEST_TOKEN_FILE")).serve
