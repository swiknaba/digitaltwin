# Non-secret defaults for the host PostgreSQL development setup.
DIGITALTWIN_PGHOST=127.0.0.1
DIGITALTWIN_PGPORT=5432
DIGITALTWIN_PGUSER=lr
DIGITALTWIN_LOCAL_DATABASE=digitaltwin_local
DIGITALTWIN_TEST_DATABASE=digitaltwin_backend_test
RACK_ENV=development
PORT=3000
HEARTBEAT_DIR=local/heartbeats
DIGITALTWIN_LOCAL_TMPDIR=local/tmp
DIGITALTWIN_COMMANDER_WORKSPACE=local/commander-workspace
DIGITALTWIN_COMMANDER_AGENT=commander
DIGITALTWIN_COMMANDER_CONTINUATION_PLUGIN_DIR=local/opencode/.opencode/plugins/digitaltwin-commander-continuation
DIGITALTWIN_HERMES_ADAPTER_PORT=3087
DIGITALTWIN_HERMES_API_PORT=8642
DIGITALTWIN_HERMES_STATE_FILE=local/hermes/commander-adapter-state.json
OPENCODE_DESKTOP_ISOLATED_SERVER=1
OPENCODE_DESKTOP_SERVER_CHANNEL=local
OPENCODE_DESKTOP_ISOLATED_SERVER_PORT=3086
DIGITALTWIN_FUTURE_TASKS_ENDPOINT=http://127.0.0.1:3000/v1/future-tasks
DIGITALTWIN_FUTURE_TASKS_CAPABILITY_SECRET_FILE=local/secrets/future-task-capability-secret
DIGITALTWIN_FUTURE_TASKS_ACTOR=local-operator
