# Disposable local development examples only; copy to ignored .env.
# These are public sample passwords, never production credentials.
# Use URL-safe passwords here; the backend database URL interpolates a URL.
POSTGRES_PASSWORD=local-only-postgres
KIREI_DB_PASSWORD=local-only-kirei
# Local Kirei web port. OpenCode is installed and operated separately.
BACKEND_PORT=3000
# Optional operator-owned Commander bridge contract. Leave unset for the
# fail-closed local core; do not put identities or capability secrets in Git.
# OPENCODE_URL=https://127.0.0.1:4096
# OPENCODE_SESSION_ID=ses_operator_session
# OPENCODE_AUTHORIZATION_FILE=/run/secrets/opencode-authorization
# FUTURE_TASK_CAPABILITY_SECRET_FILE=/run/secrets/future-task-capability-secret
