new file mode 100644
index 0000000000..453ca11abc
--- /dev/null
+++ b/packages/desktop/src/main/commander/bootstrap.ts
@@ -0,0 +1,12 @@
+import { app } from "electron"
+import { createEphemeralDesktopHarness, installHostOperatorBootstrap } from "@digitaltwin/commander-bridge/core"
+
+/** Installs only the explicit local test harness; ordinary OpenCode launch remains unconfigured. */
+export async function installCommanderDesktopBootstrap(): Promise<void> {
+  if (!process.argv.includes("--commander-test-harness")) return
+  const harness = await createEphemeralDesktopHarness()
+  installHostOperatorBootstrap(harness.bootstrap)
+  app.once("will-quit", () => {
+    void harness.close()
+  })
+}
