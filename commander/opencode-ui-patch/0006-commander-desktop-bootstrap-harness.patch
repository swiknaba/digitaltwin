--- /dev/null
+++ b/packages/desktop/src/main/commander/operator-config.ts
@@ -0,0 +1,38 @@
+import {
+  createOperatorHostBootstrap,
+  type HostOperatorBootstrap,
+  type MainProcessFetch,
+  type OperatorCapabilityExchange,
+  type OperatorDesktopIdentity,
+} from "@digitaltwin/commander-bridge/core"
+
+/** Main-process values that are constructed only after launch context validation. */
+export interface DesktopCommanderOperatorContext {
+  readonly bridgeOrigin: string
+  readonly identity: OperatorDesktopIdentity
+  readonly exchange: OperatorCapabilityExchange
+  readonly fetch: MainProcessFetch
+}
+
+/** A trusted desktop source may register exactly one operator runtime before extensions load. */
+export interface DesktopCommanderOperatorRuntime {
+  loadCommanderOperatorContext(): Promise<DesktopCommanderOperatorContext | undefined>
+}
+
+const runtimeKey = Symbol.for("@opencode/desktop/commander-operator-runtime")
+
+/** Registers a host-owned runtime; renderer and project code have no access to this API. */
+export function registerDesktopCommanderOperatorRuntime(runtime: DesktopCommanderOperatorRuntime): void {
+  const state = globalThis as Record<symbol, DesktopCommanderOperatorRuntime | undefined>
+  if (state[runtimeKey] !== undefined) throw new Error("Commander operator runtime is already registered")
+  state[runtimeKey] = runtime
+}
+
+/** Converts the registered host-owned runtime into the bridge's renderer-safe bootstrap. */
+export const desktopCommanderOperatorProvider = {
+  async load(): Promise<HostOperatorBootstrap | undefined> {
+    const state = globalThis as Record<symbol, DesktopCommanderOperatorRuntime | undefined>
+    const context = await state[runtimeKey]?.loadCommanderOperatorContext()
+    return context === undefined ? undefined : createOperatorHostBootstrap(context)
+  },
+}
diff --git a/packages/desktop/src/main/commander/operator-config-loader.ts b/packages/desktop/src/main/commander/operator-config-loader.ts
new file mode 100644
--- /dev/null
+++ b/packages/desktop/src/main/commander/operator-config-loader.ts
@@ -0,0 +1,122 @@
+import { lstat, readFile } from "node:fs/promises"
+import path from "node:path"
+import { bridgeActorId, commanderConversationId, type MainProcessFetch } from "@digitaltwin/commander-bridge/core"
+import { registerDesktopCommanderOperatorRuntime, type DesktopCommanderOperatorRuntime } from "./operator-config"
+
+type OperatorContextFile = Readonly<{ bridgeOrigin: string; capabilityBrokerOrigin: string; launchAssertion: string }>
+type LaunchAssertionClaims = Readonly<{ audience: string; actorId: string; conversationId: string }>
+
+export interface OperatorContextSource {
+  read(): Promise<string | undefined>
+}
+
+const contextFileName = "commander-operator-context.json"
+
+/**
+ * Loads a launcher-written context from Electron's private user-data directory.
+ * The broker must verify this opaque assertion's signature, expiry, audience, and identity claims.
+ */
+export async function registerConfiguredDesktopCommanderOperatorRuntime(
+  input: Readonly<{ source?: OperatorContextSource; fetch?: MainProcessFetch }> = {},
+): Promise<boolean> {
+  try {
+    const source = input.source ?? (await desktopOperatorContextSource())
+    const raw = await source.read()
+    if (raw === undefined) return false
+    const runtime = configuredRuntime(raw, input.fetch ?? { fetch })
+    if (runtime === undefined) return false
+    registerDesktopCommanderOperatorRuntime(runtime)
+    return true
+  } catch {
+    // A malformed, missing, or inaccessible operator context must not block OpenCode.
+    return false
+  }
+}
+
+export function configuredRuntime(raw: string, fetch: MainProcessFetch): DesktopCommanderOperatorRuntime | undefined {
+  const context = decodeContext(raw)
+  if (context === undefined) return undefined
+  const claims = decodeLaunchAssertion(context.launchAssertion)
+  if (claims === undefined || claims.audience !== context.capabilityBrokerOrigin) return undefined
+
+  try {
+    const identity = { actorId: bridgeActorId(claims.actorId), conversationId: commanderConversationId(claims.conversationId) }
+    return {
+      async loadCommanderOperatorContext() {
+        return {
+          bridgeOrigin: context.bridgeOrigin,
+          identity,
+          exchange: {
+            async issue(input) {
+              // The broker verifies the assertion and derives identity; no caller labels cross this boundary.
+              const response = await fetch.fetch(new URL("/v1/commander/capability", context.capabilityBrokerOrigin).toString(), {
+                method: "POST",
+                headers: { authorization: `Bearer ${context.launchAssertion}`, "content-type": "application/json" },
+                body: JSON.stringify({ audience: input.audience, action: input.action, ...(input.binding === undefined ? {} : { binding: input.binding }) }),
+              })
+              const value: unknown = await response.json()
+              if (!isRecord(value) || typeof value.token !== "string" || value.token.length === 0 || response.status !== 200) throw new Error("Commander capability broker rejected the launch assertion")
+              return { token: value.token }
+            },
+          },
+          fetch,
+        }
+      },
+    }
+  } catch {
+    return undefined
+  }
+}
+
+async function desktopOperatorContextSource(): Promise<OperatorContextSource> {
+  const { app } = await import("electron")
+  const file = path.join(app.getPath("userData"), contextFileName)
+  return {
+    async read() {
+      try {
+        const metadata = await lstat(file)
+        if (!metadata.isFile() || metadata.isSymbolicLink() || (metadata.mode & 0o077) !== 0) return undefined
+        return await readFile(file, "utf8")
+      } catch {
+        return undefined
+      }
+    },
+  }
+}
+
+function decodeContext(raw: string): OperatorContextFile | undefined {
+  try {
+    const value: unknown = JSON.parse(raw)
+    if (!isRecord(value) || typeof value.bridgeOrigin !== "string" || typeof value.capabilityBrokerOrigin !== "string" || typeof value.launchAssertion !== "string") return undefined
+    if (!isAllowedOrigin(value.bridgeOrigin) || !isAllowedOrigin(value.capabilityBrokerOrigin) || value.launchAssertion.length === 0) return undefined
+    return { bridgeOrigin: value.bridgeOrigin, capabilityBrokerOrigin: value.capabilityBrokerOrigin, launchAssertion: value.launchAssertion }
+  } catch {
+    return undefined
+  }
+}
+
+function decodeLaunchAssertion(value: string): LaunchAssertionClaims | undefined {
+  const parts = value.split(".")
+  if (parts.length !== 3 || parts.some((part) => part.length === 0)) return undefined
+  try {
+    const payload: unknown = JSON.parse(Buffer.from(parts[1]!, "base64url").toString("utf8"))
+    if (!isRecord(payload) || typeof payload.aud !== "string" || typeof payload.sub !== "string" || typeof payload.commander_conversation !== "string") return undefined
+    if (!isAllowedOrigin(payload.aud)) return undefined
+    return { audience: payload.aud, actorId: payload.sub, conversationId: payload.commander_conversation }
+  } catch {
+    return undefined
+  }
+}
+
+function isAllowedOrigin(value: string): boolean {
+  try {
+    const url = new URL(value)
+    return url.username.length === 0 && url.password.length === 0 && url.pathname === "/" && url.search.length === 0 && url.hash.length === 0 && (url.protocol === "https:" || url.hostname === "127.0.0.1" || url.hostname === "localhost" || url.hostname === "::1")
+  } catch {
+    return false
+  }
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+}
diff --git a/packages/desktop/src/main/commander/operator-config-loader.test.ts b/packages/desktop/src/main/commander/operator-config-loader.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/desktop/src/main/commander/operator-config-loader.test.ts
@@ -0,0 +1,55 @@
+import { createHmac, timingSafeEqual } from "node:crypto"
+import { describe, expect, test } from "bun:test"
+import { bridgeRequestId, capabilityPayloadDigest } from "@digitaltwin/commander-bridge/core"
+import { configuredRuntime, registerConfiguredDesktopCommanderOperatorRuntime } from "./operator-config-loader"
+
+const testBrokerKey = "test-launch-assertion-key"
+const launchAssertion = (payload: object) => {
+  const signed = `header.${Buffer.from(JSON.stringify(payload)).toString("base64url")}`
+  return `${signed}.${createHmac("sha256", testBrokerKey).update(signed).digest("base64url")}`
+}
+const validAssertion = launchAssertion({ aud: "https://broker.example", sub: "operator-7", commander_conversation: "commander:primary" })
+const validContext = JSON.stringify({ bridgeOrigin: "https://bridge.example", capabilityBrokerOrigin: "https://broker.example", launchAssertion: validAssertion })
+
+describe("operator context loader", () => {
+  test("fails closed for malformed or audience-mismatched assertions without blocking startup", async () => {
+    expect(configuredRuntime("{", failingFetch())).toBeUndefined()
+    expect(configuredRuntime(JSON.stringify({ bridgeOrigin: "https://bridge.example", capabilityBrokerOrigin: "https://broker.example", launchAssertion: "not-a-jws" }), failingFetch())).toBeUndefined()
+    expect(configuredRuntime(JSON.stringify({ bridgeOrigin: "https://bridge.example", capabilityBrokerOrigin: "https://other.example", launchAssertion: validAssertion }), failingFetch())).toBeUndefined()
+    await expect(registerConfiguredDesktopCommanderOperatorRuntime({ source: { read: async () => "{" } })).resolves.toBe(false)
+  })
+
+  test("sends a signed assertion and action binding, never caller-supplied identity labels", async () => {
+    const requests: { headers: Readonly<Record<string, string>>; body: unknown }[] = []
+    const runtime = configuredRuntime(validContext, {
+      async fetch(_url, init) {
+        verifyBrokerAssertion(init.headers.authorization, init.body)
+        requests.push({ headers: init.headers, body: JSON.parse(init.body) })
+        return { status: 200, async json() { return { token: "broker-issued-proof" } } }
+      },
+    })
+    const context = await runtime!.loadCommanderOperatorContext()
+    await expect(context!.exchange.issue({ audience: "commander-bridge", actorId: context!.identity.actorId, conversationId: context!.identity.conversationId, action: "prompt", binding: { requestId: bridgeRequestId("request-1"), payloadDigest: capabilityPayloadDigest("a".repeat(64)) } })).resolves.toEqual({ token: "broker-issued-proof" })
+    expect(requests).toEqual([{ headers: { authorization: `Bearer ${validAssertion}`, "content-type": "application/json" }, body: { audience: "commander-bridge", action: "prompt", binding: { requestId: "request-1", payloadDigest: "a".repeat(64) } } }])
+  })
+
+  test("does not issue a proof when the broker rejects an invalid launcher assertion", async () => {
+    const runtime = configuredRuntime(validContext, { async fetch(_url, init) { expect(init.headers.authorization).toBe(`Bearer ${validAssertion}`); return { status: 401, async json() { return { error: "invalid assertion" } } } } })
+    const context = await runtime!.loadCommanderOperatorContext()
+    await expect(context!.exchange.issue({ audience: "commander-bridge", actorId: context!.identity.actorId, conversationId: context!.identity.conversationId, action: "cancel" })).rejects.toThrow("rejected the launch assertion")
+  })
+})
+
+function failingFetch() {
+  return { async fetch() { throw new Error("must not fetch") } }
+}
+
+function verifyBrokerAssertion(authorization: string, body: string): void {
+  const assertion = authorization.replace(/^Bearer /, "")
+  const [header, payload, signature] = assertion.split(".")
+  const signed = `${header}.${payload}`
+  const expected = createHmac("sha256", testBrokerKey).update(signed).digest("base64url")
+  expect(timingSafeEqual(Buffer.from(signature!), Buffer.from(expected))).toBe(true)
+  expect(JSON.parse(Buffer.from(payload!, "base64url").toString("utf8"))).toMatchObject({ aud: "https://broker.example", sub: "operator-7", commander_conversation: "commander:primary" })
+  expect(JSON.parse(body)).toMatchObject({ audience: "commander-bridge", action: "prompt" })
+}
