+++ b/packages/desktop/src/main/commander/bootstrap.ts
@@ -0,0 +1,30 @@
+import { app } from "electron"
+import {
+  createEphemeralDesktopHarness,
+  installHostOperatorBootstrap,
+  type HostOperatorBootstrap,
+} from "@digitaltwin/commander-bridge/core"
+import { desktopCommanderOperatorProvider } from "./operator-config"
+
+/**
+ * The desktop main process is the only OpenCode layer allowed to install a
+ * Commander bootstrap. Project files and renderer IPC cannot call this module.
+ */
+export function installTrustedCommanderBootstrap(bootstrap: HostOperatorBootstrap): void {
+  installHostOperatorBootstrap(bootstrap)
+}
diff --git a/packages/desktop/src/main/commander/operator-config-loader.ts b/packages/desktop/src/main/commander/operator-config-loader.ts
new file mode 100644
--- /dev/null
+++ b/packages/desktop/src/main/commander/operator-config-loader.ts
@@ -0,0 +1,54 @@
+import { bridgeActorId, commanderConversationId } from "@digitaltwin/commander-bridge/core"
+import { registerDesktopCommanderOperatorRuntime } from "./operator-config"
+
+type OperatorConfig = Readonly<{ bridgeOrigin: string; capabilityBrokerOrigin: string; actorId: string; conversationId: string }>
+
+/**
+ * Reads a launch-only operator context supplied by the signed desktop launcher.
+ * It contains endpoints and verified identity labels only; proof exchange remains
+ * at the operator broker and no credential is written to OpenCode configuration.
+ */
+export function registerConfiguredDesktopCommanderOperatorRuntime(): void {
+  const raw = process.env.OPENCODE_COMMANDER_OPERATOR_CONTEXT
+  if (raw === undefined) return
+  const config = decode(raw)
+  registerDesktopCommanderOperatorRuntime({
+    async loadCommanderOperatorContext() {
+      return {
+        bridgeOrigin: config.bridgeOrigin,
+        identity: { actorId: bridgeActorId(config.actorId), conversationId: commanderConversationId(config.conversationId) },
+        exchange: { issue: async (input) => {
+          const response = await fetch(`${config.capabilityBrokerOrigin}/v1/commander/capability`, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(input) })
+          const value: unknown = await response.json()
+          if (!response.ok || !isRecord(value) || typeof value.token !== "string" || value.token.length === 0) throw new Error("Commander capability broker rejected the operator context")
+          return { token: value.token }
+        } },
+        fetch: { fetch },
+      }
+    },
+  })
+}
+
+function decode(raw: string): OperatorConfig {
+  let value: unknown
+  try { value = JSON.parse(raw) as unknown } catch { throw new Error("Commander operator context is invalid") }
+  if (!isRecord(value) || typeof value.bridgeOrigin !== "string" || typeof value.capabilityBrokerOrigin !== "string" || typeof value.actorId !== "string" || typeof value.conversationId !== "string") throw new Error("Commander operator context is invalid")
+  validateOrigin(value.bridgeOrigin); validateOrigin(value.capabilityBrokerOrigin)
+  return value
+}
+
+function validateOrigin(value: string): void {
+  const url = new URL(value)
+  if (url.pathname !== "/" || url.search || url.hash || (url.protocol !== "https:" && url.hostname !== "127.0.0.1" && url.hostname !== "localhost")) throw new Error("Commander operator context has an unsafe origin")
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> { return typeof value === "object" && value !== null && !Array.isArray(value) }
+
+/**
+ * Every launch evaluates the desktop host's supported operator adapter before a
+ * renderer exists. With no registered host context it returns undefined and the
+ * panel remains closed; the harness is an explicit test-only override.
+ */
+export async function installCommanderDesktopBootstrap(): Promise<void> {
+  const configured = await desktopCommanderOperatorProvider.load()
+  if (configured) installTrustedCommanderBootstrap(configured)
+  if (process.argv.includes("--commander-test-harness")) {
+    const harness = await createEphemeralDesktopHarness()
+    installTrustedCommanderBootstrap(harness.bootstrap)
+    app.once("will-quit", () => { void harness.close() })
+  }
+}
diff --git a/packages/desktop/src/main/commander/operator-config.ts b/packages/desktop/src/main/commander/operator-config.ts
new file mode 100644
--- /dev/null
+++ b/packages/desktop/src/main/commander/operator-config.ts
@@ -0,0 +1,44 @@
+import {
+  createOperatorHostBootstrap,
+  type HostOperatorBootstrap,
+  type MainProcessFetch,
+  type OperatorCapabilityExchange,
+  type OperatorDesktopIdentity,
+} from "@digitaltwin/commander-bridge/core"
+
+/**
+ * The signed/managed desktop embedding owns this registration. It receives no
+ * project config, renderer IPC, or environment data: all identity and proof
+ * exchange material stays behind its main-process closure.
+ */
+export interface DesktopCommanderOperatorContext {
+  readonly bridgeOrigin: string
+  readonly identity: OperatorDesktopIdentity
+  readonly exchange: OperatorCapabilityExchange
+  readonly fetch: MainProcessFetch
+}
+
+export interface DesktopCommanderOperatorRuntime {
+  loadCommanderOperatorContext(): Promise<DesktopCommanderOperatorContext | undefined>
+}
+
+const runtimeKey = Symbol.for("@opencode/desktop/commander-operator-runtime")
+
+/**
+ * Supported compiled-host injection path. The desktop distribution registers its
+ * verified OS-profile/remote-session adapter before `app.whenReady`; ordinary
+ * upstream builds register nothing and therefore fail closed.
+ */
+export function registerDesktopCommanderOperatorRuntime(runtime: DesktopCommanderOperatorRuntime): void {
+  const state = globalThis as Record<symbol, DesktopCommanderOperatorRuntime | undefined>
+  if (state[runtimeKey] !== undefined) throw new Error("Commander operator runtime is already registered")
+  state[runtimeKey] = runtime
+}
+
+export const desktopCommanderOperatorProvider = {
+  async load(): Promise<HostOperatorBootstrap | undefined> {
+    const state = globalThis as Record<symbol, DesktopCommanderOperatorRuntime | undefined>
+    const context = await state[runtimeKey]?.loadCommanderOperatorContext()
+    return context === undefined ? undefined : createOperatorHostBootstrap(context)
+  },
+}
