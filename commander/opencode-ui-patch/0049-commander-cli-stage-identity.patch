+// A local build can reuse an OpenCode release version while carrying different source. Keep this
+// separate from the service version: @opencode/client/service uses the latter to decide whether a
+// running sidecar is compatible, while staging uses the former to avoid executing a stale binary.
+const bundledIdentity = Effect.fn("DesktopCli.bundledIdentity")(function* (bundled: string) {
+  const path = yield* Path.Path
+  const identity = yield* Effect.sync(() => {
+    try {
+      return readFileSync(path.join(path.dirname(bundled), "opencode-cli.identity"), "utf8").trim()
