+
+function hermesRequest<T>(request: Readonly<{ operation: "start" | "stop" | "steer"; requestID?: string; runID?: string; text?: string }>): Promise<T> {
+  const id = crypto.randomUUID()
+  return new Promise<T>((resolve, reject) => {
+    const receive = (event: Event) => {
+      if (!(event instanceof CustomEvent) || !event.detail || event.detail.id !== id) return
+      window.removeEventListener("opencode-commander-hermes-response", receive)
+      if (typeof event.detail.error === "string") reject(new Error(event.detail.error))
+      else resolve(event.detail.result as T)
+    }
+    window.addEventListener("opencode-commander-hermes-response", receive)
+    window.dispatchEvent(new CustomEvent("opencode-commander-hermes-request", { detail: { id, ...request } }))
+  })
+}
