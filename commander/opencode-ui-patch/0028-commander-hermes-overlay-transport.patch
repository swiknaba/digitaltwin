+  const response = await fetch(adapterURL(path), { ...init, headers: { "content-type": "application/json", "authorization": `Bearer ${token}`, ...init.headers } })
+  if (!response.ok) throw new Error(`Commander Hermes adapter rejected request (${response.status}).`)
+  return response.json()
