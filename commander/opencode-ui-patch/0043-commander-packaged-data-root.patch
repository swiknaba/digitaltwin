index 000000000..b95ecb60c
--- /dev/null
+++ b/packages/desktop/src/main/lifecycle/data-root.test.ts
@@ -0,0 +1,22 @@
+import { expect, test } from "bun:test"
+import { configuredStateRoot } from "./data-root"
+
+test("uses the packaged app's explicit state root without sharing the normal desktop profile", () => {
+  expect(
+    configuredStateRoot({
+      packaged: true,
+      dataRoot: "/var/lib/digitaltwin/opencode",
+      testRoot: "/tmp/test-root",
+    }),
+  ).toBe("/var/lib/digitaltwin/opencode")
+})
+
+test("keeps the non-packaged desktop test root contract", () => {
+  expect(configuredStateRoot({ packaged: false, dataRoot: "/ignored", testRoot: "/tmp/test-root" })).toBe("/tmp/test-root")
+})
+
+test("rejects a relative packaged state root", () => {
+  expect(() => configuredStateRoot({ packaged: true, dataRoot: "relative", testRoot: undefined })).toThrow(
+    "DIGITALTWIN_OPENCODE_DATA_ROOT must be absolute.",
+  )
+})
diff --git a/packages/desktop/src/main/lifecycle/data-root.ts b/packages/desktop/src/main/lifecycle/data-root.ts
new file mode 100644
index 000000000..27cd6ca1d
--- /dev/null
+++ b/packages/desktop/src/main/lifecycle/data-root.ts
@@ -0,0 +1,19 @@
+import path from "node:path"
+
+export function configuredStateRoot(
+  input: Readonly<{
+    packaged: boolean
+    dataRoot: string | undefined
+    testRoot: string | undefined
+  }>,
+) {
+  const root = input.packaged ? input.dataRoot : input.testRoot
+
+  if (!root) return
+  if (!path.isAbsolute(root)) {
+    const name = input.packaged ? "DIGITALTWIN_OPENCODE_DATA_ROOT" : "OPENCODE_DESKTOP_TEST_ROOT"
+    throw new Error(`${name} must be absolute.`)
+  }
+
+  return root
+}
