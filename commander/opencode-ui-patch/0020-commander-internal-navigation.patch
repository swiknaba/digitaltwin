diff --git a/packages/app/src/runtime/commander-internal.test.ts b/packages/app/src/runtime/commander-internal.test.ts
new file mode 100644
index 0000000000..458bbd062e
--- /dev/null
+++ b/packages/app/src/runtime/commander-internal.test.ts
@@ -0,0 +1,26 @@
+import { describe, expect, test } from "bun:test"
+import { isCommanderInternalDirectory, isCommanderInternalSession } from "./commander-internal"
+
+describe("Commander internal navigation identity", () => {
+  test("hides only the exact configured workspace and session", () => {
+    window.dispatchEvent(
+      new CustomEvent("opencode-commander-internal", {
+        detail: {
+          directory: "/work/commander",
+          sessionID: "ses_commander",
+        },
+      }),
+    )
+
+    expect(
+      ["/work/commander", "/work/commander-notes", "/work/other-commander"].filter(
+        (directory) => !isCommanderInternalDirectory(directory),
+      ),
+    ).toEqual(["/work/commander-notes", "/work/other-commander"])
+    expect(
+      ["ses_commander", "ses_commander_notes", "ses_other_commander"].filter(
+        (sessionID) => !isCommanderInternalSession(sessionID),
+      ),
+    ).toEqual(["ses_commander_notes", "ses_other_commander"])
+  })
+})
diff --git a/packages/app/src/runtime/commander-internal.ts b/packages/app/src/runtime/commander-internal.ts
new file mode 100644
index 0000000000..adf15e47ec
--- /dev/null
+++ b/packages/app/src/runtime/commander-internal.ts
@@ -0,0 +1,30 @@
+import { createSignal } from "solid-js"
+
+export type CommanderInternal = Readonly<{ directory: string; sessionID: string }>
+
+const [commanderInternal, setCommanderInternal] = createSignal<CommanderInternal>()
+
+function updateCommanderInternal(detail: unknown) {
+  if (!detail || typeof detail !== "object") return
+  if (!("directory" in detail) || !("sessionID" in detail)) return
+  if (typeof detail.directory !== "string" || typeof detail.sessionID !== "string") return
+  setCommanderInternal({ directory: detail.directory, sessionID: detail.sessionID })
+}
+
+if (typeof window !== "undefined") {
+  updateCommanderInternal(Reflect.get(window, "__opencodeCommanderInternal"))
+  window.addEventListener("opencode-commander-internal", (event) => {
+    if (!(event instanceof CustomEvent)) return
+    updateCommanderInternal(event.detail)
+  })
+}
+
+export function isCommanderInternalDirectory(directory: string) {
+  return commanderInternal()?.directory === directory
+}
+
+export function isCommanderInternalSession(sessionID: string) {
+  return commanderInternal()?.sessionID === sessionID
+}
+
+export { commanderInternal }
