index 0000000..f5592f3
--- /dev/null
+++ b/packages/gui-extensions/src/commander/main.test.ts
@@ -0,0 +1,125 @@
+import { afterEach, beforeEach, expect, test } from "bun:test"
+import { Agent } from "@opencode/schema/agent"
+import { Session } from "@opencode/schema/session"
+import type { IpcImpl, IpcProvider, ServerEndpoint } from "../sdk/main"
+import { CommanderBridge, type CommanderBridgeState } from "./contract"
+import { createCommanderRuntime } from "./main"
+
+const caller = { window: 1, signal: AbortSignal.timeout(1_000) }
+
+const configured = { directory: "/srv/digitaltwin/commander", agent: "commander" }
+
+const original = { workspace: process.env.DIGITALTWIN_COMMANDER_WORKSPACE, agent: process.env.DIGITALTWIN_COMMANDER_AGENT, fetch: globalThis.fetch }
+
+type CommanderBridgeSpec = typeof CommanderBridge.spec
+
+beforeEach(() => {
+  process.env.DIGITALTWIN_COMMANDER_WORKSPACE = configured.directory
+  process.env.DIGITALTWIN_COMMANDER_AGENT = configured.agent
+})
+
+afterEach(() => {
+  process.env.DIGITALTWIN_COMMANDER_WORKSPACE = original.workspace
+  process.env.DIGITALTWIN_COMMANDER_AGENT = original.agent
+  globalThis.fetch = original.fetch
+})
+
+function persistent(initial: CommanderBridgeState) {
+  let value = initial
+
+  return {
+    store: {
+      get value() {
+        return value
+      },
+      set(next: CommanderBridgeState) {
+        value = next
+      },
+    },
+  }
+}
+
+function runtime(backing: ReturnType<typeof persistent>, endpoint: ServerEndpoint | undefined = sidecar()) {
+  let bridge: IpcImpl<CommanderBridgeSpec> | undefined
+  let changes = 0
+
+  const provider: IpcProvider<CommanderBridgeSpec> = {
+    changed: () => {
+      changes += 1
+    },
+    emit: () => {},
+    dispose: () => {},
+  }
+
+  createCommanderRuntime({
+    store: backing.store,
+    serverEndpoints: { get: () => endpoint },
+    provide: (impl) => {
+      bridge = impl
+
+      return provider
+    },
+  })
+
+  if (!bridge) throw new Error("Commander bridge was not provided")
+
+  return { bridge, changes: () => changes }
+}
+
+function sidecar(): ServerEndpoint {
+  return { id: "sidecar", url: "http://127.0.0.1:4096", headers: { authorization: "Bearer sidecar" }, local: true }
+}
+
+function agents(ids: readonly string[]) {
+  const request = async (...[input, init]: Parameters<typeof fetch>) => {
+    const url = new URL(input.toString())
+    expect(url.pathname).toBe("/api/agent")
+    expect(url.searchParams.get("location[directory]")).toBe(configured.directory)
+    expect(init?.headers).toEqual({ authorization: "Bearer sidecar" })
+
+    return Response.json({ location: { directory: configured.directory }, data: ids.map((id) => ({ id })) })
+  }
+
+  globalThis.fetch = Object.assign(request, { preconnect: original.fetch.preconnect })
+}
+
+test("Commander recreates from persisted state only after validating its configured sidecar agent", async () => {
+  agents([configured.agent])
+  const backing = persistent({ revision: 0 })
+  const first = runtime(backing)
+  const session = Session.ID.make("ses_commander_persisted")
+
+  await expect(first.bridge.reserve({ serverID: "sidecar", sessionID: session }, caller)).resolves.toMatchObject({
+    revision: 1,
+    conversation: { serverID: "sidecar", sessionID: session, directory: configured.directory, agent: configured.agent },
+  })
+  expect(first.changes()).toBe(1)
+
+  const recreated = runtime(backing)
+  await expect(recreated.bridge.reserve({ serverID: "sidecar", sessionID: Session.ID.make("ses_ignored") }, caller)).resolves.toEqual(backing.store.value)
+  expect(recreated.changes()).toBe(0)
+})
+
+test("Commander rejects missing or changed persisted agent configuration without rewriting it", async () => {
+  process.env.DIGITALTWIN_COMMANDER_AGENT = "retired"
+  agents([configured.agent])
+
+  const missing = persistent({
+    revision: 4,
+    conversation: { serverID: "sidecar", sessionID: Session.ID.make("ses_missing"), directory: configured.directory, agent: Agent.ID.make("retired") },
+  })
+
+  await expect(runtime(missing).bridge.reserve({ serverID: "sidecar", sessionID: Session.ID.make("ses_new") }, caller)).rejects.toThrow("Configured Commander agent 'retired' is unavailable")
+  expect(missing.store.value.revision).toBe(4)
+
+  process.env.DIGITALTWIN_COMMANDER_AGENT = configured.agent
+  agents([configured.agent])
+
+  const changed = persistent({
+    revision: 5,
+    conversation: { serverID: "sidecar", sessionID: Session.ID.make("ses_changed"), directory: "/srv/old", agent: Agent.ID.make(configured.agent) },
+  })
+
+  await expect(runtime(changed).bridge.reserve({ serverID: "sidecar", sessionID: Session.ID.make("ses_newer") }, caller)).rejects.toThrow("saved state does not match the current operator workspace or agent")
+  expect(changed.store.value.revision).toBe(5)
+})
