+/** Installs the durable Commander bridge over the app's normal authenticated sidecar endpoint. */
+export function createCommanderRuntime(input: CommanderRuntime) {
+  let provider: IpcProvider<CommanderBridgeSpec>
+
+  provider = input.provide({
+    state: () => input.store.value,
+    reserve: async (reservation) => {
+      const endpoint = input.serverEndpoints.get(reservation.serverID)
+
+      if (!endpoint) throw new Error("Commander requires the OpenCode sidecar.")
+
+      const configured = configuredCommander()
+      await validateConfiguredCommander({ endpoint, ...configured })
+      const current = input.store.value
+
+      if (current.conversation) {
+        if (!matchesConfiguredConversation(current.conversation, configured)) {
+          throw new Error("Commander saved state does not match the current operator workspace or agent. Clear the saved Commander state before changing either setting.")
+        }
+
+        return current
+      }
+
+      const next: CommanderBridgeState = { revision: current.revision + 1, conversation: { ...reservation, ...configured } }
+      input.store.set(next)
       provider.changed()
 
       return next
     },
   })
+
+  return provider
+}
+
+const setup: MainSetup<typeof definition> = (ctx) => {
+  createCommanderRuntime({
+    store: ctx.stores.conversation,
+    serverEndpoints: ctx.serverEndpoints,
+    provide: (impl) => ctx.provide(CommanderBridge, impl),
+  })
 }
 
 export default setup
