@@ -0,0 +1,110 @@
+import type { Ipc, IpcClient, IpcSpec } from "@opencode/gui-extensions/sdk"
+import { expect, sourceURL, story } from "../../storybook/playwright/story"
+
+const fixture = sourceURL(new URL("./extension-host.fixture.tsx", import.meta.url))
+
+const modules = {
+  fixture,
+  commander: sourceURL(new URL("../../gui-extensions/src/commander/index.ts", import.meta.url)),
+  renderer: sourceURL(new URL("../../gui-extensions/src/commander/renderer.tsx", import.meta.url)),
+  contract: sourceURL(new URL("../../gui-extensions/src/commander/contract.ts", import.meta.url)),
+}
+
+type CommanderClient = Pick<IpcClient<IpcSpec>, "state" | "on"> & {
+  open(): Promise<CommanderState>
+  send(input: { text: string }): Promise<CommanderState>
+  steer(input: { text: string }): Promise<CommanderState>
+  cancel(): Promise<CommanderState>
+  reconnect(input: { after: number }): Promise<CommanderState>
+}
+
+type CommanderState = {
+  status: "active"
+  events: { cursor: number; kind: "delta" | "notice" | "final"; text: string }[]
+}
+
+story.beforeEach(async ({ mount, page }) => {
+  // The local client is the renderer's typed IPC boundary. It models only sanitized
+  // panel state, never an operator proof, conversation identity, or bridge endpoint.
+  await mount("ui-line-comment--editor")
+  let opened: { current: string; opened: { key: string; session: string }[] } | undefined
+  for (let attempt = 0; attempt < 2; attempt++) {
+    try {
+      opened = await page.evaluate(async (modules) => {
+    const [{ mountSessionRegion, until }, commander, contract] = await Promise.all([
+      import(modules.fixture),
+      import(modules.commander),
+      import(modules.contract),
+    ])
+    let events: { cursor: number; kind: "delta" | "notice" | "final"; text: string }[] = [
+      { cursor: 1, kind: "notice", text: "Commander harness opened" },
+    ]
+    const snapshot = () => ({ status: "active" as const, events })
+    const client: CommanderClient = {
+      open: async () => snapshot(),
+      send: async ({ text }) => {
+        events = [...events, { cursor: 2, kind: "delta", text: `stream: ${text}` }]
+        return snapshot()
+      },
+      steer: async ({ text }) => {
+        events = [...events, { cursor: 3, kind: "notice", text: `steer: ${text}` }]
+        return snapshot()
+      },
+      cancel: async () => {
+        events = [...events, { cursor: 5, kind: "final", text: "cancelled" }]
+        return snapshot()
+      },
+      reconnect: async ({ after }) => {
+        events = [...events, { cursor: 4, kind: "notice", text: `reconnected after ${after}` }]
+        return snapshot()
+      },
+      state: () => undefined,
+      on: () => () => undefined,
+    }
+    const region = mountSessionRegion({
+      definitions: [{ ...commander.default, renderer: () => import(modules.renderer) }],
+      active: "commander:main",
+      ipc: (token: Ipc) => (token.id === contract.CommanderBridge.id ? client : undefined),
+    })
+
+    await until(() => region.status("commander") === "active")
+    region.openTitlebar()
+
+    return { current: region.current(), opened: region.opened }
+      }, modules)
+      break
+    } catch (error) {
+      // Vite can replace the Storybook iframe once when it first optimizes the new workspace import.
+      if (attempt || !String(error).includes("Execution context was destroyed")) throw error
+      await page.waitForLoadState("domcontentloaded")
+    }
+  }
+
+  expect(opened).toEqual({ current: "a", opened: [{ key: "commander:main", session: "a" }] })
+})
+
+story(
+  "opens Commander without replacing its project session, streams, reconnects, steers, and cancels",
+  async ({ page }, testInfo) => {
+    const panel = page.getByTestId("session-region-fixture")
+    const message = panel.getByRole("textbox", { name: "Commander message" })
+
+    await expect(panel.getByText("Connected", { exact: true })).toBeVisible()
+    await expect(panel.getByText("Commander harness opened", { exact: true })).toBeVisible()
+
+    await message.fill("Run the acceptance fixture")
+    await panel.getByRole("button", { name: "Send", exact: true }).click()
+    await expect(panel.getByText("stream: Run the acceptance fixture", { exact: true })).toBeVisible()
+
+    await message.fill("Keep the project session selected")
+    await panel.getByRole("button", { name: "Steer", exact: true }).click()
+    await expect(panel.getByText("steer: Keep the project session selected", { exact: true })).toBeVisible()
+
+    await panel.getByRole("button", { name: "Reconnect", exact: true }).click()
+    await expect(panel.getByText("reconnected after 3", { exact: true })).toBeVisible()
+
+    await panel.getByRole("button", { name: "Cancel", exact: true }).click()
+    await expect(panel.getByText("cancelled", { exact: true })).toBeVisible()
+    await panel.screenshot({ path: testInfo.outputPath("commander-panel.png") })
+  },
+)
