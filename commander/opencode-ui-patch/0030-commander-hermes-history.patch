+async function history() {
+  const value = await adapter("/history")
+  if (!Array.isArray(value)) throw new Error("Commander Hermes adapter returned invalid history.")
+  return value.flatMap((item, index) => {
+    if (!item || typeof item !== "object" || !("role" in item) || !("content" in item)) return []
+    if ((item.role !== "user" && item.role !== "assistant") || typeof item.content !== "string") return []
+    return [{ seq: index, type: item.role === "assistant" ? "completed" : "output", runID: "history", text: item.content }]
+  })
+}
