+import { useExtension } from "../sdk"
+import type definition from "./index"
+
+export function CommanderPanel() {
+  const extension = useExtension<typeof definition>()
+
+  return (
+    <div class="flex h-full flex-col gap-2 p-4">
+      <h2 class="text-14-medium text-v2-text-text-base">{extension.t("panel.title")}</h2>
+      <p class="text-13-regular text-v2-text-text-muted">{extension.t("panel.description")}</p>
+      <p class="text-13-regular text-v2-text-text-muted">{extension.t("panel.status")}</p>
+    </div>
+  )
+}
diff --git a/packages/gui-extensions/src/commander/renderer.tsx b/packages/gui-extensions/src/commander/renderer.tsx
new file mode 100644
index 0000000..6a9aab0
--- /dev/null
+++ b/packages/gui-extensions/src/commander/renderer.tsx
@@ -0,0 +1,66 @@
+import { lazy, onCleanup, Suspense } from "solid-js"
+import { Command, onIdle, Panel, TitlebarItem, type PanelTab, type Setup } from "../sdk"
+import type definition from "./index"
+
+const panelID = "main"
+
+const setup: Setup<typeof definition> = (ctx) => {
+  const panelKey = `${ctx.id}:${panelID}`
+  const CommanderPanel = lazy(() => import("./panel"))
+  const tab: PanelTab = {
+    id: panelID,
+    get title() {
+      return ctx.t("title")
+    },
+    pinned: true,
+    closable: false,
+    dom: { tab: "session-side-panel-commander-tab", panel: "session-side-panel-commander-tabpanel" },
+  }
+
+  const open = () => {
+    const session = ctx.sessions.current()
+
+    if (session) ctx.layout.open(panelKey, session, { tab: "select" })
+  }
+
+  onCleanup(onIdle(() => void CommanderPanel.preload()))
+
+  ctx.add(TitlebarItem, {
+    id: "open",
+    label: ctx.t("title"),
+    title: ctx.t("action.open"),
+    icon: "cube",
+    run: open,
+  })
+
+  ctx.add(
+    Command,
+    () => ({
+      id: "open",
+      get title() {
+        return ctx.t("command.open")
+      },
+      get description() {
+        return ctx.t("command.description")
+      },
+      get group() {
+        return ctx.t("command.category.view")
+      },
+      enabled: !!ctx.sessions.current(),
+      run: open,
+    }),
+  )
+
+  ctx.add(Panel, {
+    id: panelID,
+    region: "side",
+    list: (input) => (input.open.includes(panelID) ? [tab] : []),
+    render: () => (
+      <Suspense>
+        <CommanderPanel />
+      </Suspense>
+    ),
+  })
+}
+
+export default setup
