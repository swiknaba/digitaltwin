--- /dev/null
+++ b/packages/app/component-tests/commander-vite-fixture/commander-vite-fixture.spec.ts
@@ -0,0 +1,39 @@
+import { expect, test } from "@playwright/test"
+
+test("Commander uses visible models, sends native composer prompts, persists selection, and stays in bounds", async ({ page }) => {
+  await page.goto("/")
+  const overlay = page.locator('[data-slot="commander-native-overlay"]')
+  await expect(overlay).toBeVisible()
+  await expect(overlay.getByText("Controlled Commander response 80")).toBeVisible()
+
+  const picker = overlay.locator('[data-action="composer-model"]')
+  await picker.click()
+  await expect(page.locator('[data-option-key="fixture:commander-small"]')).toBeVisible()
+  await expect(page.locator('[data-option-key="fixture:commander-large"]')).toBeVisible()
+  await expect(page.getByText("Hidden Commander", { exact: true })).toHaveCount(0)
+  await page.locator('[data-option-key="fixture:commander-large"]').click()
+  await expect(picker).toContainText("Commander Large")
+
+  const prompt = overlay.locator('[contenteditable="true"]')
+  await prompt.fill("send this from Commander")
+  await expect(overlay.getByRole("button", { name: "Send" })).toBeEnabled()
+  const sent = page.waitForRequest((request) => request.method() === "POST" && request.url().includes("/api/session/ses_commander_fixture/prompt"))
+  await overlay.getByRole("button", { name: "Send" }).click()
+  const request = await sent
+  expect(request.postDataJSON()).toMatchObject({ text: "send this from Commander" })
+
+  await overlay.getByRole("button", { name: "Close" }).click()
+  await page.evaluate(() => window.commanderFixture?.reopen())
+  await expect(overlay).toBeVisible()
+  await expect(overlay.locator('[data-action="composer-model"]')).toContainText("Commander Large")
+
+  const bounds = await overlay.boundingBox()
+  expect(bounds).not.toBeNull()
+  expect(bounds!.x).toBeGreaterThanOrEqual(0)
+  expect(bounds!.y).toBeGreaterThanOrEqual(36)
+  expect(bounds!.x + bounds!.width).toBeLessThanOrEqual(1280)
+  expect(bounds!.y + bounds!.height).toBeLessThanOrEqual(800)
+
+  await page.evaluate(() => window.commanderFixture?.setColorScheme("dark"))
+  await expect(page.locator("html")).toHaveAttribute("data-color-scheme", "dark")
+})
