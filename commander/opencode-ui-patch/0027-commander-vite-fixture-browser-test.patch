+import { fileURLToPath } from "node:url"
+import { defineConfig } from "vite"
+import tailwindcss from "@tailwindcss/vite"
+import solid from "vite-plugin-solid"
+
+export default defineConfig({
+  root: fileURLToPath(new URL(".", import.meta.url)),
+  plugins: [solid(), tailwindcss(), {
+    name: "commander-fixture-api",
+    configureServer(server) {
+      server.middlewares.use((request, response, next) => {
+        if (!request.url?.startsWith("/api/")) return next()
+        console.log(request.url)
+        if (request.url.startsWith("/api/event")) {
+          response.writeHead(200, { "content-type": "text/event-stream", "cache-control": "no-cache" })
+          response.write("data: {\\\"id\\\":\\\"evt_fixture_connected\\\",\\\"type\\\":\\\"server.connected\\\",\\\"data\\\":{}}\\n\\n")
+          return
+        }
+        if (request.method === "POST" && (request.url.includes("/agent") || request.url.includes("/model"))) {
+          response.statusCode = 204
+          response.end()
+          return
+        }
+        response.setHeader("content-type", "application/json")
+        response.end(JSON.stringify(fixture(request.url)))
+      })
+    },
+  }],
+  resolve: { alias: { "@": fileURLToPath(new URL("../../src", import.meta.url)) } },
+  server: { host: "127.0.0.1", port: 4173, strictPort: true },
+})
+
+function fixture(path: string) {
+  if (path.startsWith("/api/info")) return { version: "fixture", pid: 1, urls: ["http://127.0.0.1:4173"], paths: { tmp: "/fixture/tmp" } }
+  if (path.includes("/session/ses_commander_fixture/inbox")) return { data: [] }
+  if (path.startsWith("/api/provider")) return { location: { directory: "/fixture/commander" }, data: [{ id: "fixture", name: "Fixture", activation: "enabled", package: "fixture" }] }
+  if (path.startsWith("/api/model")) return { location: { directory: "/fixture/commander" }, data: [model("commander-small", "Commander Small", "small"), model("commander-large", "Commander Large", "large"), model("hidden", "Hidden Commander", "hidden", "deprecated")] }
+  if (path.includes("/session/ses_commander_fixture/message")) return { data: Array.from({ length: 80 }, (_, index) => ({ id: `msg_${index}`, type: "assistant", agent: "commander", model: { providerID: "fixture", modelID: "commander" }, content: [{ type: "text", text: `Controlled Commander response ${index + 1}` }], time: { created: 1_790_000_000_000 + index } })), cursor: {} }
+  if (path.includes("/session/ses_commander_fixture")) return { data: { id: "ses_commander_fixture", slug: "commander", projectID: "project-fixture", directory: "/fixture/commander", version: "1", agent: "commander", title: "Commander", cost: 0, tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } }, time: { created: 1_790_000_000_000, updated: 1_790_000_000_000 } } }
+  if (path.includes("/health")) return { healthy: true }
+  return { data: [] }
+}
+
+function model(id: string, name: string, family: string, status: "active" | "deprecated" = "active") {
+  return { id, modelID: id, providerID: "fixture", name, family, capabilities: { tools: true, input: ["text"], output: ["text"] }, variants: [], time: { released: 1_790_000_000_000 }, cost: [], status, enabled: true, limit: { context: 8192, output: 1024 } }
+}
