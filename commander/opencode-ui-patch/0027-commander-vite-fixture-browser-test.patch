+import "../../src/index.css"
+import { render } from "solid-js/web"
+import { onMount } from "solid-js"
+import { AppBaseProviders, AppInterface } from "../../src/app"
+import { CommanderOverlayHost } from "../../src/runtime/commander-overlay"
+import { ServerProvider } from "../../src/runtime/server/current"
+import { PlatformProvider } from "../../src/runtime/platform/platform"
+import { ExtensionAttachment } from "../../src/runtime/extension/root"
+import { LayoutProvider } from "../../src/shell/state/layout"
+import { SettingsSurfaceProvider } from "../../src/settings/surface"
+
+const server = { type: "http" as const, authToken: false, http: { url: "http://127.0.0.1:4173" } }
+const conversation = { serverID: "sidecar" as const, sessionID: "ses_commander_fixture", directory: "/fixture/commander", agent: "commander" }
+type Model = { providerID: string; modelID: string }
+
+declare global {
+  interface Window {
+    commanderFixture?: { reopen(): void; setColorScheme(scheme: "light" | "dark"): void }
+  }
+}
+
+function Fixture() {
+  let model: Model = { providerID: "fixture", modelID: "commander-small" }
+  const open = () => window.dispatchEvent(new CustomEvent("opencode-commander-overlay", { detail: { conversation, model } }))
+  onMount(() => {
+    window.addEventListener("opencode-commander-model-select", (event) => {
+      if (!(event instanceof CustomEvent) || !event.detail) return
+      model = event.detail as Model
+    })
+    window.commanderFixture = {
+      reopen: open,
+      setColorScheme: (scheme) => document.documentElement.dataset.colorScheme = scheme,
+    }
+    window.setTimeout(open, 50)
+  })
+  return <ServerProvider conn={server}><CommanderOverlayHost /></ServerProvider>
+}
+
+render(() => <PlatformProvider value={{ platform: "web", openExternal() {}, restart: async () => {}, notify: async () => {} }}><AppBaseProviders locale="en"><AppInterface servers={[server]}><LayoutProvider><SettingsSurfaceProvider><ExtensionAttachment><Fixture /></ExtensionAttachment></SettingsSurfaceProvider></LayoutProvider></AppInterface></AppBaseProviders></PlatformProvider>, document.getElementById("root")!)
