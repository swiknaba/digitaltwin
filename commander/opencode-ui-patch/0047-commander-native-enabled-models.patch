+it.live("lists only models explicitly enabled in native desktop settings for local automation", () =>
+  Effect.gen(function* () {
+    const project = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-model-enabled-endpoint-")))
+    const desktop = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-desktop-model-settings-")))
+    const previous = process.env.DIGITALTWIN_OPENCODE_DATA_ROOT
+    process.env.DIGITALTWIN_OPENCODE_DATA_ROOT = desktop.path
+    yield* Effect.addFinalizer(() =>
+      Effect.sync(() => {
+        if (previous === undefined) delete process.env.DIGITALTWIN_OPENCODE_DATA_ROOT
+        else process.env.DIGITALTWIN_OPENCODE_DATA_ROOT = previous
+      }),
+    )
+    yield* Effect.promise(() =>
+      fs.writeFile(
+        path.join(project.path, "opencode.json"),
+        JSON.stringify({
+          providers: {
+            custom: {
+              package: "aisdk:@ai-sdk/openai-compatible",
+              settings: { apiKey: "secret" },
+              models: { explicitlyEnabled: {}, implicitlyAvailable: {} },
+            },
+          },
+        }),
+      ),
+    )
+    yield* Effect.promise(() => fs.mkdir(path.join(desktop.path, "desktop"), { recursive: true }))
+    yield* Effect.sync(() => writeDesktopModelSettings(desktop.path))
+    const server = yield* startServer(project.path)
+    const url = new URL("/api/model/enabled", server.base)
+    url.searchParams.set("location[directory]", project.path)
+    const response = yield* Effect.promise(() => fetch(url, { headers: server.headers }))
+
+    expect(response.status).toBe(200)
+    const body: unknown = yield* Effect.promise(() => response.json())
+    if (!isRecord(body) || !Array.isArray(body["data"])) throw new Error("Expected an enabled model list response")
+    expect(body["data"].map(modelID)).toEqual(["explicitlyEnabled"])
+  }),
+)
+
+function writeDesktopModelSettings(root: string) {
+  const desktop = path.join(root, "desktop")
+  const file = path.join(desktop, "drafts.sqlite")
+  const database = new DatabaseSync(file)
+
+  try {
+    database.exec("CREATE TABLE state (name TEXT NOT NULL, key TEXT NOT NULL, value TEXT NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (name, key))")
+    database
+      .prepare("INSERT INTO state (name, key, value, updated_at) VALUES (?, ?, ?, ?)")
+      .run(
+        "opencode.global.dat",
+        "model",
+        JSON.stringify({
+          user: [
+            { providerID: "custom", modelID: "explicitlyEnabled", visibility: "show" },
+            { providerID: "custom", modelID: "implicitlyAvailable", visibility: "hide" },
+          ],
+        }),
+        Date.now(),
+      )
+  } finally {
+    database.close()
+  }
+}
+
+function modelID(value: unknown): string | undefined {
+  if (!isRecord(value) || typeof value["id"] !== "string") return
+  return value["id"]
+}
+
 function isRecord(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null && !Array.isArray(value)
 }
