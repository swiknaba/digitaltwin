 import { Model } from "@opencode/core/model"
-import { Effect } from "effect"
+import { existsSync } from "node:fs"
+import path from "node:path"
+import { DatabaseSync } from "node:sqlite"
+import { Effect, Option, Schema } from "effect"
 import { HttpApiBuilder } from "effect/http-api"
 import { Api } from "../api"
 import { awaitPlugins, response } from "../location"
@@ -23,5 +26,71 @@ export const ModelHandler = HttpApiBuilder.group(Api, "server.model", (handlers)
           return yield* response(models.default())
         }),
       )
+      .handle(
+        "model.enabled",
+        Effect.fn(function* () {
+          yield* awaitPlugins
+          const models = yield* Model.Service
+          const enabled = desktopEnabledModels()
+          return yield* response(
+            models.available().pipe(
+              Effect.map((available) => available.filter((model) => enabled.has(modelKey(model.providerID, model.id)))),
+            ),
+          )
+        }),
+      )
   }),
 )
+
+const DesktopModelState = Schema.Struct({
+  user: Schema.Array(
+    Schema.Struct({
+      providerID: Schema.String,
+      modelID: Schema.String,
+      visibility: Schema.Literals(["show", "hide"]),
+    }),
+  ),
+})
+
+function desktopEnabledModels(): ReadonlySet<string> {
+  const root = process.env.DIGITALTWIN_OPENCODE_DATA_ROOT
+
+  if (!root) return new Set()
+
+  const file = path.join(root, "desktop", "drafts.sqlite")
+
+  if (!existsSync(file)) return new Set()
+
+  try {
+    const database = new DatabaseSync(file, { readOnly: true })
+
+    try {
+      const row = database
+        .prepare("SELECT value FROM state WHERE name = ? AND key = ?")
+        .get("opencode.global.dat", "model")
+      const value = columnValue(row)
+      const decoded = value === undefined
+        ? Option.none()
+        : Schema.decodeUnknownOption(Schema.fromJsonString(DesktopModelState))(value)
+
+      return Option.match(decoded, {
+        onNone: () => new Set(),
+        onSome: (state) => new Set(state.user.filter((item) => item.visibility === "show").map((item) => modelKey(item.providerID, item.modelID))),
+      })
+    } finally {
+      database.close()
+    }
+  } catch {
+    // A local automation must never select a model when desktop preferences are unreadable.
+    return new Set()
+  }
+}
+
+function columnValue(value: unknown): string | undefined {
+  if (!value || typeof value !== "object" || !("value" in value) || typeof value.value !== "string") return
+  return value.value
+}
+
+function modelKey(providerID: string, modelID: string) {
+  return `${providerID}:${modelID}`
+}
