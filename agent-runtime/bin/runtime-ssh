#!/bin/sh
set -eu
[ "$(id -u)" = 10001 ]
[ -r /run/runtime-ssh/ssh_host_ed25519_key ] || { echo 'Operator-owned SSH host key is required' >&2; exit 1; }
[ -r "$HOME/.ssh/authorized_keys" ] || { echo 'Operator-owned authorized_keys is required' >&2; exit 1; }
exec /usr/sbin/sshd -D -e -f /opt/runtime/config/sshd_config
