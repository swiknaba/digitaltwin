#!/bin/bash
set -euo pipefail
image=${1:-digitaltwin-runtime-worker:20261001}
name="digitaltwin-runtime-test-$(date +%s)-$$"
cleanup() { docker rm -fv "$name" >/dev/null 2>&1 || true; }
trap cleanup EXIT
docker run -d --name "$name" --platform linux/amd64 --network none --cap-drop ALL --security-opt no-new-privileges "$image" >/dev/null
ready() {
  for attempt in $(seq 1 30); do
    if docker exec "$name" /opt/runtime/bin/runtime-health; then return; fi
    sleep 1
  done
  docker logs "$name" >&2
  return 1
}
ready
# Deliberately fail the first assertion, followed by success. Neither shell may mask it.
if docker exec "$name" sh -ec 'test -e /var/run/docker.sock; true'; then
  echo 'FAIL: noninteractive shell masked early assertion failure' >&2; exit 1
fi
if docker exec "$name" bash -elc 'test "$(command -v rg)" = /deliberately-wrong-path; true'; then
  echo 'FAIL: login shell masked early assertion failure' >&2; exit 1
fi
printf 'PASS: deliberately failed first assertion exits nonzero in both shells\n'
docker exec "$name" /opt/runtime/bin/runtime-smoke --server
docker exec -e CLI_STARTUP_PROBE_KINDS=gemini,hermes,grok "$name" sh -c 'python3 /opt/runtime/bin/cli-startup-probe.py > /tmp/cli-startup-probe.jsonl'
docker exec -i "$name" python3 - <<'PY'
import json
from pathlib import Path

observations = [json.loads(line) for line in Path('/tmp/cli-startup-probe.jsonl').read_text().splitlines()]
assert [observation['cli'] for observation in observations] == ['gemini', 'hermes', 'grok']
assert all(observation['authenticated'] is False for observation in observations)
by_cli = {observation['cli']: observation for observation in observations}
# A vendor UI may wait for its unreachable service in this network-disabled
# probe. Hermes and Grok Build must still enroll as Herdr agents locally.
assert by_cli['hermes']['startup_exit'] == 0
assert by_cli['grok']['startup_exit'] == 0
assert '"agent":"hermes"' in by_cli['hermes']['startup_response']
assert '"agent":"grok"' in by_cli['grok']['startup_response']
PY
docker exec "$name" sh -ec 'test "$(grok --version)" = "grok 1.0.46 (2765805b9442)"; test "$(grep -E "^auto_update = false$" "$HOME/.grok/config.toml")" = "auto_update = false"; test -x "$HOME/.grok/hooks/herdr-agent-state.sh"; test -f "$HOME/.grok/hooks/herdr.json"'
# A second container using the shared volumes and agreed UID reaches the real API.
docker run --rm --platform linux/amd64 --user 10001:10001 --volumes-from "$name" --cap-drop ALL --security-opt no-new-privileges --entrypoint /opt/runtime/bin/runtime-health "$image"
docker exec "$name" sh -ec 'test "$(awk "/CapEff/ {print \$2}" /proc/1/status)" = 0000000000000000; test ! -e /var/run/docker.sock; printf preserved > /workspace/restart-fixture; printf preserved > "$HOME/restart-fixture"'
docker inspect "$name" | python3 -c 'import json,sys; c=json.load(sys.stdin)[0]; assert c["Config"]["User"]=="10001:10001"; assert not c["HostConfig"]["Privileged"]; assert not c["HostConfig"]["PortBindings"]; assert all(m["Type"]=="volume" for m in c["Mounts"]); print("PASS: UID, capabilities, volumes, no public ports")'
docker exec "$name" bash -elc 'git init -q /workspace/repos/fixture; git -C /workspace/repos/fixture config user.name "Runtime fixture"; git -C /workspace/repos/fixture config user.email fixture@example.invalid; printf fixture > /workspace/repos/fixture/file; git -C /workspace/repos/fixture add file; git -C /workspace/repos/fixture commit -qm fixture; git -C /workspace/repos/fixture worktree add -qb fixture /workspace/worktrees/fixture'
docker exec "$name" herdr workspace create --label restart-fixture --cwd /workspace/worktrees/fixture >/dev/null
docker exec "$name" sh -ec 'printf "%s\\n" "skills: { create_dir: custom, external_dirs: [/tmp/custom] }" "mcp_servers:" "  kept:" "    command: /bin/true" > /workspace/commander/.hermes/config.yaml'
docker restart "$name" >/dev/null
ready
docker exec "$name" sh -ec 'mkdir -p "$HOME/.agents/skills/shared-reference"; printf "%s\\n" "---" "name: shared-reference" "description: Shared worker skill fixture." "---" "Use this shared fixture." > "$HOME/.agents/skills/shared-reference/SKILL.md"; test "$(cat /workspace/restart-fixture)" = preserved; test "$(cat "$HOME/restart-fixture")" = preserved; test -d /workspace/commander/.git; test "$(git -C /workspace/commander log -1 --pretty=%s)" = "Initialize Commander workspace"; test -f /workspace/commander/AGENTS.md; test -f /workspace/commander/SOUL.md; test -f /workspace/commander/.gitignore; test -f /workspace/commander/.hermes/config.yaml; grep -q "create_dir: custom" /workspace/commander/.hermes/config.yaml; grep -q -- "- /tmp/custom" /workspace/commander/.hermes/config.yaml; grep -q "command: /bin/true" /workspace/commander/.hermes/config.yaml; grep -q "/home/runtime/.agents/skills" /workspace/commander/.hermes/config.yaml; hermes skills list | grep -q shared-reference; test -f "$HOME/.codex/hooks.json"; test -f "$HOME/.claude/settings.json"'
docker exec "$name" sh -ec 'mkdir -p /workspace/commander/.hermes/memories /workspace/commander/.hermes/skills/baseline /workspace/commander/.hermes/learned-skills/example; printf memory > /workspace/commander/.hermes/memories/MEMORY.md; printf baseline > /workspace/commander/.hermes/skills/baseline/SKILL.md; printf skill > /workspace/commander/.hermes/learned-skills/example/SKILL.md; : > /workspace/commander/.hermes/state.db; git -C /workspace/commander check-ignore -q .hermes/state.db; ! git -C /workspace/commander check-ignore -q .hermes/memories/MEMORY.md; ! git -C /workspace/commander check-ignore -q .hermes/skills/baseline/SKILL.md; ! git -C /workspace/commander check-ignore -q .hermes/learned-skills/example/SKILL.md; git -C /workspace/commander add .hermes/memories/MEMORY.md .hermes/skills/baseline/SKILL.md .hermes/learned-skills/example/SKILL.md; git -C /workspace/commander diff --cached --name-only | grep -qx .hermes/memories/MEMORY.md; git -C /workspace/commander diff --cached --name-only | grep -qx .hermes/skills/baseline/SKILL.md; git -C /workspace/commander diff --cached --name-only | grep -qx .hermes/learned-skills/example/SKILL.md'
docker exec "$name" herdr api snapshot | jq -e 'any(.result.snapshot.workspaces[]; .label == "restart-fixture")' >/dev/null
docker exec "$name" bash -elc 'test "$(git -C /workspace/repos/fixture rev-parse HEAD)" = "$(git -C /workspace/worktrees/fixture rev-parse HEAD)"; test -d "$(git -C /workspace/worktrees/fixture rev-parse --path-format=absolute --git-common-dir)"; test -z "$(git -C /workspace/worktrees/fixture status --porcelain)"'
printf 'PASS: real socket from second container and persistent home/workspace/Herdr metadata/Git worktree after restart\n'
